# DataSentry Environment Variables

# Offline mock LLM backend (default: true; set to false to use live watsonx.ai)
DATASENTRY_USE_MOCK_LLM=true

# IBM watsonx.ai Configuration
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# Security & Guardrail Configuration
DATASENTRY_POLICY_PATH=policies/security_policy.yaml
DATASENTRY_AUDIT_LOG_PATH=logs/audit_log.jsonl
DATASENTRY_DRY_RUN=true
DATASENTRY_MAX_STEPS=10
